// Typecheck-only config that also covers `test/`.
// The base tsconfig.json is scoped to `src/` because the build emits
// declarations with rootDir "./src"; tests must not land in dist.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["bun"]
  },
  "include": ["src/**/*", "test/**/*"]
}
